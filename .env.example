# Production settings for lms.superocbs.com, for reference.
# The two secrets are left blank on purpose: this file is committed to git.
# The real values are in .env.production (ignored by git) and on the server.

# ------------------------------------------------------------------ database
LOGISTICS_DB_HOST=localhost
LOGISTICS_DB_PORT=3306
LOGISTICS_DB_NAME=superocbs_superocbs_lms
LOGISTICS_DB_USER=superocbs_lmsuser
LOGISTICS_DB_PASS=
LOGISTICS_DB_CHARSET=utf8mb4

# ----------------------------------------------------------------- addresses
APP_NAME=LMS

# Blank: the app sits at the root of its own subdomain.
LOGISTICS_BASE_URL=

APP_URL=https://lms.superocbs.com

# Never 1 on a server anyone can reach.
APP_DEBUG=0

# --------------------------------------------------------------------- email
RESEND_API_KEY=
SMTP_FROM_EMAIL=lms@superocbs.com
SMTP_FROM_NAME=ITEC Ltd

INITIAL_REPLY_TO=info@gmail.com

# Blank so mail reaches the real recipient.
MAIL_REDIRECT_ALL_TO=

MAIL_SEND_IN_CLI=0
MAIL_ENDPOINT=https://api.resend.com/emails

# ------------------------------------------------------------------- uploads
UPLOAD_PATH=
UPLOAD_MAX_BYTES=5242880
