# Copy this file to .env and fill in the real values for this machine.
# .env is ignored by git: nothing secret and nothing installation-specific ever
# reaches the repository. config/config.php reads everything from here, so the
# same code runs on a laptop and on a customer's server without being edited.

# ------------------------------------------------------------------ database
LOGISTICS_DB_HOST=127.0.0.1
LOGISTICS_DB_PORT=3306
LOGISTICS_DB_NAME=logistics_mvc
LOGISTICS_DB_USER=root
LOGISTICS_DB_PASS=
LOGISTICS_DB_CHARSET=utf8mb4

# ----------------------------------------------------------------- addresses
# The name shown in the browser tab and in page titles.
APP_NAME=LMS

# The path the app is served under.
#   served at https://lms.example.com          -> leave blank
#   served at https://example.com/logistics    -> /logistics
#   XAMPP at http://localhost/logistics-mvc    -> /logistics-mvc
LOGISTICS_BASE_URL=

# The full public address, used for links inside emails, which cannot be
# relative. Leave blank and the running request is used instead — which works in
# a browser but produces no link from the console, so set it before you rely on
# mailed links. No trailing slash.
#   APP_URL=https://lms.example.com
APP_URL=

# Show the full error on screen instead of a plain failure page. Never on a
# server the public can reach.
APP_DEBUG=0

# --------------------------------------------------------------------- email
# Resend (https://resend.com). Without a key the system still records every
# message it meant to send, in Administration > Email outbox, and sends none.
RESEND_API_KEY=

# The address mail is sent from. Its domain must be verified with the provider,
# or the provider will refuse to send to anyone but the account owner.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Where a reply goes, if it should not go to the from address.
INITIAL_REPLY_TO=

# Test mode. Set an address here and every message goes there instead of to its
# real recipient, with a banner saying who it was addressed to. Leave blank in
# production so mail reaches the address on the record.
MAIL_REDIRECT_ALL_TO=

# The console queues messages but does not send them, so a test run or a
# migration never mails real people. Set to 1 to send from the console on
# purpose.
MAIL_SEND_IN_CLI=0

# Only change this to point at a different provider's compatible endpoint.
MAIL_ENDPOINT=https://api.resend.com/emails

# ------------------------------------------------------------------- uploads
# Where proof-of-delivery files and receipts are written. Leave blank to use
# storage/uploads inside the project. On a server, a path outside the web root
# is better: nothing there should be reachable except through the app.
UPLOAD_PATH=

# Largest file anyone may attach, in bytes. 5242880 is 5 MB.
UPLOAD_MAX_BYTES=5242880
