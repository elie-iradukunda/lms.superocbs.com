

# Only the subdomain is let in; localhost and 127.0.0.1 too, for local
# development (XAMPP). Whatever is let in is then sent into public/, so the
# code, storage/ and .env are never reachable directly. public/ has its own
# RewriteEngine, so on the subdomain (document root = public/) these rules are
# not inherited.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} !^(lms\.superocbs\.com|localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^ - [F]

    RewriteRule ^$ public/ [L]
    RewriteRule ^((?!public/).*)$ public/$1 [L]
</IfModule>

# And whatever happens to rewriting, this file is never served.
<Files ".env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>
